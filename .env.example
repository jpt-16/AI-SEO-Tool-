# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings → Environment Variables.

# Google Cloud OAuth client (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Supabase → Project Settings → API. Server-only; never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts the Google refresh token at rest: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Browser login for the whole app (HTTP Basic auth)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel Cron sends this as a Bearer token to /api/cron/gsc-sync: openssl rand -hex 32
CRON_SECRET=

# Gemini API key for the Blueprints (AI review) feature: aistudio.google.com → Get API key.
# Use a key on a billing-enabled project: free-tier prompts can be used to improve Google's products.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash; if you change it, set the prices (USD per million tokens)
# so the cost shown on the Blueprints page is right.
# GEMINI_MODEL=
# GEMINI_INPUT_USD_PER_MTOK=
# GEMINI_OUTPUT_USD_PER_MTOK=

# Automatic outreach (optional). How many businesses each daily run handles (default 6, max 12).
# OUTREACH_PER_RUN=6
# A postal address added to the end of every outreach email (US commercial email law asks for one).
# OUTREACH_POSTAL_ADDRESS=

# Where outreach drafts are saved: your Gmail address and an app password for it
# (myaccount.google.com/apppasswords; needs 2-Step Verification). The tool only ever adds drafts.
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
